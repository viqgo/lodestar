{
  "name": "lodestar",
  "version": "0.2.0",
  "description": "A desktop app that teaches step by step using the AI CLI you already have",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --mac dmg --arm64 --x64",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.mts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "io.github.viqgo.lodestar",
    "productName": "lodestar",
    "files": [
      "out/**"
    ],
    "artifactName": "lodestar-${version}-${arch}.dmg",
    "mac": {
      "target": "dmg",
      "identity": "-",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "lodestar listens to your spoken answers during a call."
      }
    }
  }
}
